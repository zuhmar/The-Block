{
  "name": "street-survival",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @street/client dev",
    "setup": "pnpm install && docker compose up -d --wait && pnpm db:migrate && pnpm assets:generate",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "assets:generate": "tsx packages/art-tools/generate.ts",
    "assets:validate": "tsx packages/art-tools/validate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "build": "pnpm typecheck && pnpm assets:validate && pnpm --filter @street/client build",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "map:preview": "tsx packages/art-tools/render-official-map.ts",
    "dev:legacy": "pnpm assets:generate && concurrently -k -n server,client 'pnpm --filter @street/server dev' 'pnpm --filter @street/client dev'",
    "assets:models": "tsx packages/art-tools/export-actor-models.ts",
    "assets:buildings": "tsx packages/art-tools/export-building-models.ts",
    "assets:street-v2": "blender -b -t 4 --python packages/art-tools/build-street-v2.py",
    "assets:image-characters": "blender -b -t 4 --python packages/art-tools/build-image-characters.py",
    "assets:image-npcs": "blender -b -t 4 --python packages/art-tools/build-image-npcs.py",
    "assets:weapons": "blender -b -t 4 --python packages/art-tools/build-weapons.py",
    "assets:blender-buildings": "tsx packages/art-tools/export-building-layout.ts && blender -b -t 4 --python packages/art-tools/build-blender-buildings.py && blender -b -t 4 --python packages/art-tools/build-jail.py && blender -b -t 4 --python packages/art-tools/build-apartments.py && blender -b -t 4 --python packages/art-tools/build-military.py && blender -b -t 4 --python packages/art-tools/build-town-expansion.py && blender -b -t 4 --python packages/art-tools/build-street-furniture.py",
    "assets:meshy-shadow": "blender -b -t 4 --python packages/art-tools/animate-meshy-shadow.py",
    "assets:meshy-lookout": "blender -b -t 4 --python packages/art-tools/animate-meshy-lookout.py",
    "assets:meshy-police": "MESHY_NPC=police blender -b -t 4 --python packages/art-tools/animate-meshy-lookout.py",
    "assets:meshy-swat": "MESHY_NPC=swat blender -b -t 4 --python packages/art-tools/animate-meshy-lookout.py",
    "assets:meshy-outfits": "MESHY_PLAYER_TIER=street blender -b -t 4 --python packages/art-tools/animate-meshy-shadow.py && MESHY_PLAYER_TIER=reinforced blender -b -t 4 --python packages/art-tools/animate-meshy-shadow.py && MESHY_PLAYER_TIER=armored blender -b -t 4 --python packages/art-tools/animate-meshy-shadow.py",
    "assets:meshy-warehouse": "blender -b -t 4 --python packages/art-tools/build-meshy-warehouse.py",
    "assets:wood-kit": "blender -b -t 4 --python packages/art-tools/build-wood-kit.py",
    "assets:loot-chests": "blender -b -t 4 --python packages/art-tools/build-loot-chests.py",
    "assets:jail": "tsx packages/art-tools/export-building-layout.ts && blender -b -t 4 --python packages/art-tools/build-jail.py",
    "assets:apartments": "tsx packages/art-tools/export-building-layout.ts && blender -b -t 4 --python packages/art-tools/build-apartments.py",
    "assets:military": "tsx packages/art-tools/export-building-layout.ts && blender -b -t 4 --python packages/art-tools/build-military.py",
    "assets:town-expansion": "tsx packages/art-tools/export-building-layout.ts && blender -b -t 4 --python packages/art-tools/build-town-expansion.py && blender -b -t 4 --python packages/art-tools/build-street-furniture.py",
    "assets:weapon-sprites": "blender -b -t 4 --python packages/art-tools/render-weapon-sprites.py && python packages/art-tools/pack-weapon-sprites.py && pnpm assets:heavy-weapons",
    "assets:heavy-weapons": "blender -b -t 4 --python packages/art-tools/prepare-heavy-weapons.py",
    "assets:nature-sprites": "python packages/art-tools/pack-nature-sprites.py",
    "assets:nature-models": "blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-nature-models.py && python packages/art-tools/pack-nature-models.py",
    "assets:harvest-tools": "blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-harvest-tools.py && python packages/art-tools/pack-harvest-tools.py",
    "assets:harbor": "tsx packages/art-tools/export-harbor.ts && blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-harbor.py",
    "assets:resource-items": "blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-resource-items.py && python packages/art-tools/pack-resource-items.py",
    "assets:ammo": "blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-ammo.py && blender -b -t 4 --python-exit-code 1 --python packages/art-tools/optimize-ammo.py && python packages/art-tools/pack-ammo.py",
    "assets:sounds": "python packages/art-tools/build-sounds.py",
    "assets:crafting": "blender -b -t 4 --python-exit-code 1 --python packages/art-tools/build-crafting.py && python packages/art-tools/pack-crafting.py"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/three": "^0.187.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/ws-transport": "^0.16.0",
    "colyseus.js": "^0.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "^8.14.1",
    "phaser": "^3.88.2",
    "sharp": "^0.34.0",
    "three": "^0.187.0",
    "vite": "^6.2.0",
    "zod": "^3.24.0"
  }
}
